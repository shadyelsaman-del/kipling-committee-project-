# Google service account (Google Cloud Console → APIs & Services → Credentials)
# Share your Google Sheet and Drive folder with this service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the downloaded JSON key, with \n for line breaks
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# A Google Drive folder ID to store payment screenshots in:
# https://drive.google.com/drive/folders/THIS_PART_IS_THE_ID
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Shared committee password for the /admin dashboard
ADMIN_PASSWORD=change-me
